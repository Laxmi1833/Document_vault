{
  "name": "document-vault",
  "version": "1.0.0",
  "description": "Document Vault GraphQL API — organize documents into collections",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "gendb": "bunx prisma migrate dev && bunx prisma generate",
    "test": "bun test",
    "test:unit": "bun test --preload ./tests/helpers/mock.ts tests/unit/",
    "test:integration": "bun test tests/integration/",
    "lint": "bunx tsc --noEmit",
    "typecheck": "bunx tsc --noEmit",
    "sanity": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "prisma": "^7.9.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.22.0",
    "pg": "^8.23.0"
  }
}